# Copy to .env and fill in. Never commit .env. None of these values are ever sent to a browser.
# dev | test | staging | prod. staging and prod share every safety check: the app refuses to start with unsafe
# settings (test/live Paystack key in the wrong env, local file storage, no SMTP, non-https URLs, no AI budget,
# $0 AI prices, no LEGAL_TERMS_VERSION, scanning off).
ENV=dev
# preview = private online preview: deployed guards, but UPLOADS_ENABLED=false, EMAIL_BACKEND=none allowed and
# sign-up limited to SIGNUP_ALLOWLIST. staging and prod never get those relaxations.
# SIGNUP_ALLOWLIST=["you@example.com"]   # JSON list; empty = anyone may sign up. Required in preview.
RELEASE=dev                     # set by the deploy pipeline to the git SHA; shown by /health
LOG_FORMAT=text                 # json in staging/prod (one line per event; no query strings, bodies or secrets)
# SENTRY_DSN=                   # error tracking; personal data is not sent

# The API connects as the low-privilege app role (RLS applies). Migrations use the owner role.
DATABASE_URL=postgresql+psycopg://eco_app:CHANGE_ME@localhost:5432/eco
MIGRATIONS_DATABASE_URL=postgresql+psycopg://eco_owner:CHANGE_ME@localhost:5432/eco

# Auth: local (built-in) or external_jwt (e.g. Supabase Auth / another OIDC provider)
AUTH_MODE=local
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# EXTERNAL_JWKS_URL=
# EXTERNAL_JWT_ISSUER=
# EXTERNAL_JWT_AUDIENCE=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
# To rotate: put a NEW key first, comma, then the old one(s). Remove an old key only after all rows re-encrypt.

# External integrations (docs/INTEGRATIONS.md)
PUBLIC_WEB_URL=http://localhost:3000        # redirect URI = PUBLIC_WEB_URL/integrations/callback
OUTBOUND_HTTP_ENABLED=true                  # false = no call to any provider (kill switch)
FX_PROVIDER_ENABLED=true                    # ExchangeRate-API open access (no key; attribution shown)
REMOTIVE_ENABLED=true                       # public feed (no key; fetch cap enforced in code)
GOOGLE_OAUTH_CLIENT_ID=                     # YouTube analytics; leave empty to hide Connect
GOOGLE_OAUTH_CLIENT_SECRET=

# Email (password reset). none | dev_outbox (dev/test only: captured, never sent) | smtp (any provider's relay)
EMAIL_BACKEND=none
# SMTP_HOST=
# SMTP_PORT=587                 # STARTTLS is required
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM="New Age AI <no-reply@mail.example.com>"   # a domain with SPF, DKIM and DMARC
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=3

# Legal: the version of the Terms/Privacy Policy users accept at sign-up. Required when deployed.
# LEGAL_TERMS_VERSION=2026-12-01
# Account deletion: closed workspaces are erased (files included) after this many days by scripts/purge_deleted.py
PURGE_AFTER_DAYS=30

# Files (deployed environments must use s3: container disks are not durable)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/storage
# S3_BUCKET=
# S3_ENDPOINT_URL=
MAX_UPLOAD_BYTES=20971520
# UPLOADS_ENABLED=true          # false: uploads refused with a clear message (preview only may then skip S3 + ClamAV)
# clamav in every shared environment; disabled_dev_only is refused when ENV=prod
FILE_SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# AI (server-side only). Switch vendors with AI_PROVIDER; check model names and prices on the vendor's
# current docs and price page before setting them.
AI_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_MODEL_FAST=        # router + summarizer; falls back to AI_MODEL
# Per-model prices in USD per 1M tokens, as JSON: {"model-name": [input, output]}. REQUIRED when deployed:
# with $0 prices, fair use and the daily budget never trigger. Copy them from the vendor's price page.
AI_MODEL_PRICES={}
AI_PRICE_IN_PER_1M_USD=0
AI_PRICE_OUT_PER_1M_USD=0
AI_RATE_LIMIT_PER_MINUTE=20
FAIR_USE_MONTHLY_USD_PER_USER=50
# Whole-service daily AI spend cap in USD (0 = off; required when deployed). At the cap new generations pause until
# midnight UTC; a warning is logged at AI_BUDGET_ALERT_RATIO.
AI_DAILY_BUDGET_USD=0
AI_BUDGET_ALERT_RATIO=0.8
AI_MAX_TOOL_STEPS=6
# Retrieval embeddings: none | openai | hash_dev_only (dev/test only; refused in prod)
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# Payments
PAYSTACK_SECRET_KEY=

# Comma-separated JSON list of allowed frontend origins; never "*" in prod
CORS_ORIGINS=["http://localhost:3000"]

# Client IP and per-IP limits on sign-in / sign-up / password reset (0 = off).
# X-Forwarded-For is believed only from these addresses: our web server and any load balancer in front of it.
TRUSTED_PROXIES=["127.0.0.1/32","::1/128"]
LOGIN_IP_MAX_FAILURES=30          # failed sign-ins per IP per 15 minutes
SIGNUP_IP_PER_HOUR=10
FORGOT_IP_PER_HOUR=10
# These per-IP counters live in Postgres (auth_attempts), so they hold across workers and instances.
# The integrations token bucket is per process (it only smooths calls; provider fetch caps use the shared cache).

# Backups and restore drills (scripts/backup.py, scripts/restore_drill.py)
# BACKUP_S3_BUCKET=             # private, versioned, in a different account from production
# BACKUP_S3_ENDPOINT_URL=
# BACKUP_RETENTION_DAYS=35
# RESTORE_ADMIN_URL=            # a role that may CREATE DATABASE on a separate drill server
# Deploy-time only: ALLOW_DESTRUCTIVE_MIGRATION=<revision> lets scripts/predeploy apply that one destructive migration

# Tuning (the defaults are fine; listed so every setting is documented)
# DB_POOL_SIZE=10
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# LOGIN_MAX_FAILURES=10          # per account, then locked for LOGIN_LOCKOUT_MINUTES
# LOGIN_LOCKOUT_MINUTES=15
# DOWNLOAD_URL_TTL_SECONDS=900
# AI_TIMEOUT_SECONDS=60
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_VERSION=2023-06-01
# RESEARCH_BACKEND=none          # live web research isn't connected yet (planned integration)
