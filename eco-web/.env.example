# Server-side only: the browser never sees this or any token. All API calls go through /api/proxy.
API_URL=http://localhost:8000
# Set to "true" behind HTTPS (staging and production): auth cookies become Secure and HSTS is sent.
COOKIE_SECURE=false
# Staging only: tells search engines not to index any page.
NOINDEX=false
# Set to true only when this server sits behind a load balancer/CDN that sets X-Forwarded-For (e.g. Vercel).
# Then the API sees each visitor's real IP for the audit log and per-IP sign-in limits. Also list that proxy in the
# API's TRUSTED_PROXIES. Leave false otherwise: a visitor could write their own X-Forwarded-For.
TRUST_FORWARDED_FOR=false
