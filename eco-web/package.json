{
  "name": "eco-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/run.mjs",
    "start:prod": "mkdir -p .next/standalone/.next .next/standalone/src && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && cp -r src/content .next/standalone/src/ && node .next/standalone/server.js"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "10.4.21",
    "axe-core": "^4.10.2",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
